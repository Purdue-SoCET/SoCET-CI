# syntax=docker/dockerfile:1.7
# Used to Build Image for ghrc

FROM verilator/verilator:v5.036

ARG DEBIAN_FRONTEND=noninteractive
ARG FUSESOC_VERSION=2.3.0
ARG PYTHON_VERSION=3.10

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Base packages and GCC 13 toolchain
RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common gnupg gpg-agent dirmngr ca-certificates \
    && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
    && apt-get update && apt-get install -y --no-install-recommends \
        git python${PYTHON_VERSION} python3-pip ssh make perl \
        gcc-13 g++-13 \
        autoconf flex bison libfl2 libfl-dev \
        libgoogle-perftools-dev libevent-dev zlib1g-dev \
        libboost-all-dev \
        ccache pkg-config curl \
        cmake psmisc \
        gcc-riscv64-unknown-elf binutils-riscv64-unknown-elf \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
        --slave /usr/bin/g++ g++ /usr/bin/g++-13 \
        --slave /usr/bin/cc cc /usr/bin/gcc-13 \
        --slave /usr/bin/c++ c++ /usr/bin/g++-13 \
    && update-alternatives --set gcc /usr/bin/gcc-13 \
    && ln -s /usr/bin/ccache /usr/lib/ccache/gcc-13 2>/dev/null || true \
    && ln -s /usr/bin/ccache /usr/lib/ccache/g++-13 2>/dev/null || true \
    && rm -rf /var/lib/apt/lists/*

ENV CC=gcc-13
ENV CXX=g++-13

# Ensure riscv64-unknown-elf-gcc symlink exists if needed
RUN if ! command -v riscv64-unknown-elf-gcc >/dev/null 2>&1; then \
        ln -s $(which riscv64-unknown-elf-gcc || which riscv64-linux-gnu-gcc) /usr/local/bin/riscv64-unknown-elf-gcc; \
    fi

# FuseSoC and python installation 
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip \
&& python3 -m pip install "fusesoc==${FUSESOC_VERSION}" PyYAML

# ssh setup
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh \
&& ssh-keyscan github.com >> /root/.ssh/known_hosts

#ccache for future C/C++ compiles
ENV PATH="/usr/lib/ccache:${PATH}"
ENV CCACHE_DIR=/root/.ccache

# #script execution 
# COPY install_digital_libs.sh /install_digital_libs.sh
# RUN chmod +x /install_digital_libs.sh

# # install digital libs using ssh key
# RUN --mount=type=secret,id=SSH_PRIVATE_KEY \
#      /install_digital_libs.sh
     
# no entrypoint, start container in shell
CMD ["/bin/bash"]
